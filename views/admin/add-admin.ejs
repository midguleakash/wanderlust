<% layout("/layouts/boilerplate.ejs") %>

    <div class="container mt-4">

        <div class="row justify-content-center">

            <div class="col-md-7">

                <div class="card shadow-sm">

                    <div class="card-body p-3">

                        <h3 class="mb-2">
                            Add New Admin
                        </h3>

                        <p class="text-muted">
                            Enter the administrator details and verify the
                            email using OTP.
                        </p>

                        <hr>


                        <form action="/admin/admins/create" method="POST" id="adminForm">

                            <!-- Username -->

                            <div class="mb-3">

                                <label for="username" class="form-label">
                                    Username
                                </label>

                                <input type="text" name="username" id="username" class="form-control" required
                                    minlength="3">

                            </div>


                            <!-- Email -->

                            <div class="mb-3">

                                <label for="email" class="form-label">
                                    Email
                                </label>

                                <input type="email" name="email" id="email" class="form-control" required>

                            </div>


                            <!-- Common OTP -->

                            <%- include("../includes/otp.ejs") %>


                                <!-- Password -->

                                <div class="mb-3 mt-3">

                                    <label for="password" class="form-label">
                                        Password
                                    </label>

                                    <input type="password" name="password" id="password" class="form-control"
                                        minlength="3" required>

                                </div>


                                <!-- Confirm Password -->

                                <div class="mb-3">

                                    <label for="confirmPassword" class="form-label">
                                        Confirm Password
                                    </label>

                                    <input type="password" name="confirmPassword" id="confirmPassword"
                                        class="form-control" minlength="3" required>

                                </div>


                                <!-- Create Admin -->

                                <button type="submit" id="createAdminBtn" class="btn btn-primary" disabled>
                                    Create Admin
                                </button>


                                <a href="/admin/admins" class="btn btn-secondary">
                                    Cancel
                                </a>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <script>

        const adminForm =
            document.getElementById("adminForm");


        adminForm.addEventListener("submit", (e) => {

            const createAdminBtn =
                document.getElementById("createAdminBtn");


            if (createAdminBtn.disabled) {

                e.preventDefault();

                document.getElementById("otpMessage").innerHTML = `
                <span class="text-danger">
                    Please verify email using OTP first.
                </span>
            `;

            }

        });

    </script>
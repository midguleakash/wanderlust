<% layout("/layouts/boilerplate.ejs") %>

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Listing Details</h2>

            <p class="text-muted mb-0">
                Manage your property and view how it appears to guests.
            </p>
        </div>

        <a href="/host/listings" class="btn btn-secondary">
            ← Back to My Listings
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <!-- Image -->
                <div class="col-md-6">

                    <img
                        src="<%= listing.image.url %>"
                        alt="<%= listing.title %>"
                        class="img-fluid rounded"
                        style="width: 100%; max-height: 400px; object-fit: cover;"
                    >

                </div>


                <!-- Details -->
                <div class="col-md-6">

                    <h2 class="mb-3">
                        <%= listing.title %>
                    </h2>


                    <!-- Location -->
                    <p>
                        <strong>Location:</strong>
                        <%= listing.location %>
                    </p>


                    <!-- Country -->
                    <p>
                        <strong>Country:</strong>
                        <%= listing.country %>
                    </p>


                    <!-- Price -->
                    <p>
                        <strong>Price:</strong>
                        ₹<%= listing.price %> / night
                    </p>


                    <!-- Status -->
                    <p>
                        <strong>Status:</strong>

                        <% if (listing.isHidden) { %>

                            <span class="badge bg-danger">
                                Hidden
                            </span>

                        <% } else { %>

                            <span class="badge bg-success">
                                Active
                            </span>

                        <% } %>

                    </p>


                    <hr>


                    <!-- Description -->
                    <h5>Description</h5>

                    <p class="text-muted">
                        <%= listing.description %>
                    </p>


                    <hr>


                    <!-- Actions -->

                    <div class="d-flex gap-2 flex-wrap">

                        <!-- View as Guest -->
                        <a
                            href="/listings/<%= listing._id %>"
                            class="btn btn-info"
                        >
                            View as Guest
                        </a>


                        <!-- Edit -->
                        <a
                            href="/host/listings/<%= listing._id %>/edit"
                            class="btn btn-warning"
                        >
                            Edit Listing
                        </a>


                        <!-- Delete -->
                        <form
                            action="/host/listings/<%= listing._id %>?_method=DELETE"
                            method="POST"
                            class="d-inline"
                            onsubmit="return confirm('Are you sure you want to delete this listing?');"
                        >

                            <button
                                type="submit"
                                class="btn btn-danger"
                            >
                                Delete Listing
                            </button>

                        </form>

                    </div>

                </div>

            </div>


            <!-- Reviews -->

            <hr class="my-4">

            <h4 class="ps-2">Reviews</h4>

            <% if (listing.reviews.length === 0) { %>

                <p class="text-muted ps-2">
                    No reviews yet.
                </p>

            <% } else { %>

                <div class="row mt-3">

                    <% listing.reviews.forEach(review => { %>

                        <div class="col-md-6 mb-3">

                            <div class="card">

                                <div class="card-body">

                                    <h6>
                                        <%= review.author.username %>
                                    </h6>

                                    <p class="mb-1">
                                        Rating:
                                        <%= review.rating %> / 5
                                    </p>

                                    <p class="text-muted mb-0">
                                        <%= review.comment %>
                                    </p>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } %>

        </div>

    </div>

</div>
<% layout("/layouts/boilerplate.ejs") %>

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>My Listings</h2>

            <p class="text-muted mb-0">
                View and manage your properties.
            </p>
        </div>

        

    </div>


    <!-- Listings -->
    <div class="card shadow-sm">

        <div class="card-body">

            <% if (listings.length === 0) { %>

                <div class="text-center py-5">

                    <h5 class="text-muted">
                        No listings found.
                    </h5>

                    <p class="text-muted">
                        You have not created any property yet.
                    </p>

                    <a href="/host/listings/new" class="btn btn-success">
                        + Add New Listing
                    </a>

                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Title</th>
                                <th>Location</th>
                                <th>Price / Night</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>


                        <tbody>

                            <% listings.forEach(listing => { %>

                                <tr>

                                    <!-- Image -->
                                    <td>

                                        <img
                                            src="<%= listing.image.url %>"
                                            alt="<%= listing.title %>"
                                            style="
                                                width: 90px;
                                                height: 65px;
                                                object-fit: cover;
                                                border-radius: 6px;
                                            "
                                        >

                                    </td>


                                    <!-- Title -->
                                    <td>
                                        <strong>
                                            <%= listing.title %>
                                        </strong>
                                    </td>


                                    <!-- Location -->
                                    <td>
                                        <%= listing.location %>
                                    </td>


                                    <!-- Price -->
                                    <td>
                                        ₹<%= listing.price %>
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        <% if (listing.isHidden) { %>

                                            <span class="badge bg-danger">
                                                Hidden
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-success">
                                                Active
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <!-- View -->
                                        <a
                                            href="/host/listings/<%= listing._id %>"
                                            class="btn btn-info btn-sm"
                                        >
                                            View
                                        </a>


                                        <!-- Edit -->
                                        <a
                                            href="/host/listings/<%= listing._id %>/edit"
                                            class="btn btn-warning btn-sm"
                                        >
                                            Edit
                                        </a>


                                        <!-- Delete -->
                                        <form
                                            action="/host/listings/<%= listing._id %>?_method=DELETE"
                                            method="POST"
                                            class="d-inline"
                                            onsubmit="return confirm('Are you sure you want to delete this listing?');"
                                        >

                                            <button
                                                type="submit"
                                                class="btn btn-danger btn-sm"
                                            >
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</div>